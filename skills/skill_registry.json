    {
      "skill_id": "HC.CONSTRAINT.IMBALANCE",
      "skill_code": "SK-08",
      "version": "1.0.0",
      "name": "三相不平衡校核",
      "purpose": "由三相复电压求序分量，按批准定义计算不平衡度并定位最不利相与时段。",
      "business_scope": ["capacity_assessment", "capacity_publication", "access_check", "remediation_review"],
      "object_levels": ["dt", "feeder"],
      "requires_engine": true,
      "engine": {"id": "opendss", "interface": "OpenDSSDirect.py"},
      "module": "hc_agent.model.constraints",
      "entrypoints": ["ConstraintEvaluator.evaluate_imbalance",
                      "negative_sequence_imbalance"],
      "inputs": [
        {"field": "bus_results.csv", "unit": "V/deg", "required": true,
         "note": "需要三相复电压（幅值+相角）"},
        {"field": "rules.yaml:IMBALANCE_LIMIT", "unit": "pct", "required": true}
      ],
      "preconditions": [
        "相别映射经校验：导体编号不等于业务相别的假设必须验证",
        "同一母线同一时刻三相齐全"
      ],
      "procedure": [
        "1. 按 (scenario,bus,timestamp) 聚合 A/B/C 三相复电压。",
        "2. 求序分量：V1=(Va+aVb+a²Vc)/3，V2=(Va+a²Vb+aVc)/3，a=1∠120°。",
        "3. 不平衡度 = 100×|V2|/|V1|。",
        "4. 仅幅值不能完整求该指标；缺相角时标 unknown。",
        "5. 若业务采用电流幅值偏差等其他定义，须使用不同 metric_id 与独立规则。",
        "6. 输出最不利母线、时段与三相幅值明细。"
      ],
      "outputs": [
        {"field": "imbalance", "unit": "pct"}, {"field": "phase", "unit": "-"},
        {"field": "threshold", "unit": "pct"}, {"field": "time", "unit": "-"},
        {"field": "metric_definition", "unit": "-"}
      ],
      "failure_policy": {
        "retryable": [],
        "needs_data": ["三相电压不全", "相角缺失"],
        "needs_human": ["不平衡定义口径需确认"],
        "forbidden": ["混用不同的不平衡定义", "用幅值近似替代序分量计算"]
      },
      "evidence_policy": ["metric_definition", "constraint_id", "bus_results.csv"],
      "safety_boundary": ["只读分析", "模型不支持中性线时不得宣称已覆盖全部低压不平衡风险"],
      "test_suite": {
        "golden": ["tests/golden/FD001", "tests/golden/FD002"],
        "negative_cases": ["三相不平衡越限", "缺相", "相别映射错误"]
      },
      "owner": "配网专业组",
      "approver": "配网专业复核人",
      "status": "approved",
      "risk_level": "medium"
    },
    {
      "skill_id": "HC.CONSTRAINT.SHORTCIRCUIT",
      "skill_code": "SK-09",
      "version": "1.0.0",
      "name": "短路容量与保护触发校核",
      "purpose": "校验新增电源后短路水平与设备开断能力，输出短路电流与保护复核触发标志。",
      "business_scope": ["capacity_assessment", "access_check"],
      "object_levels": ["feeder", "substation"],
      "requires_engine": true,
      "engine": {"id": "opendss", "interface": "OpenDSSDirect.py",
                 "api": ["Set mode=FaultStudy", "Bus.Isc", "Bus.ZscMatrix",
                         "New Fault"]},
      "module": "hc_agent.engines.opendss_adapter",
      "entrypoints": ["OpenDSSAdapter.short_circuit",
                      "ConstraintEvaluator.evaluate_short_circuit"],
      "inputs": [
        {"field": "fault_models.csv", "unit": "-", "required": true,
         "note": "逆变器故障电流模型与有效期；缺少模型则相关短路能力 unknown"},
        {"field": "rules.yaml:SHORT_CIRCUIT_LIMIT", "unit": "A", "required": true},
        {"field": "零序参数 r0/x0", "unit": "ohm/km", "required": true}
      ],
      "preconditions": [
        "短路与零序参数完整",
        "故障类型、故障电阻、接地方式、上级电源阻抗与分布式电源故障模型已冻结"
      ],
      "procedure": [
        "1. 设置 Set mode=FaultStudy 并求解，读取母线等值量。",
        "2. 明确记录：FaultStudy 的母线等值量不能直接当成任意接地或相间故障的实际电流。",
        "3. 按故障方案新建显式 Fault 元件求解具体故障电流，读取对应端子结果。",
        "4. 与设备开断能力及系统边界比较。",
        "5. 缺少故障模型或零序参数时标 unknown（能力未覆盖）。",
        "6. 恢复 Set mode=snapshot 并记录状态。"
      ],
      "outputs": [
        {"field": "fault_level", "unit": "A"}, {"field": "rating", "unit": "A"},
        {"field": "margin", "unit": "A"}, {"field": "location", "unit": "-"},
        {"field": "status", "unit": "enum", "note": "pass/fail/unknown"}
      ],
      "failure_policy": {
        "retryable": ["依赖加载失败"],
        "needs_data": ["短路模型或零序参数缺失"],
        "needs_human": ["保护配合需专业判断"],
        "forbidden": ["把 FaultStudy 等值量当实际故障电流",
                      "把未验证的逆变器故障响应标为已覆盖",
                      "称为保护配合或暂态稳定验证"]
      },
      "evidence_policy": ["fault_spec", "bus_isc", "zsc", "fault_element_currents"],
      "safety_boundary": ["只读分析", "仅稳态短路计算", "不含暂态稳定与保护配合验证"],
      "test_suite": {
        "golden": ["IEEETestCases（含短路算例）", "tests/golden/FD001"],
        "negative_cases": ["缺故障模型", "零序参数缺失", "故障元件不收敛"]
      },
      "owner": "计算引擎组",
      "approver": "配网专业复核人",
      "status": "approved",
      "risk_level": "high"
    },
    {
      "skill_id": "HC.CAPACITY.SEARCH",
      "skill_code": "SK-10",
      "version": "1.0.0",
      "name": "开放容量搜索",
      "purpose": "在指定对象、时间窗、场景、分配与控制权限下搜索使全部强制约束仍满足的最大新增容量。",
      "business_scope": ["capacity_publication", "capacity_assessment"],
      "object_levels": ["dt", "feeder", "substation"],
      "requires_engine": true,
      "engine": {"id": "opendss", "interface": "OpenDSSDirect.py"},
      "module": "hc_agent.capacity_search",
      "entrypoints": ["search_capacity", "check_monotonicity"],
      "inputs": [
        {"field": "task.search", "unit": "kW", "required": true,
         "note": "lower_kw、upper_kw、precision_kw、max_iter"},
        {"field": "task.allocation_mode", "unit": "-", "required": true},
        {"field": "rules.yaml:search", "unit": "-", "required": true}
      ],
      "preconditions": [
        "基线全场景收敛且满足基线准入规则",
        "候选接入点与分配权重已确定",
        "单调性已验证或明确采用离散扫描"
      ],
      "procedure": [
        "1. 计算当前基线状态并确认所有基准场景收敛；基线已违规时先输出存量问题。",
        "2. 试探下界；下界不可行则物理容量为 0。",
        "3. 试探上界；上界仍可行只能输出'至少为上界'并按规则扩展搜索，不得宣称找到最大值。",
        "4. 上界不可行才形成可行/不可行括区间。",
        "5. 仅当可行性随增量容量单调已验证且采用固定接入分配时执行二分；否则使用经批准步长的离散全域扫描。",
        "6. unknown（超时/不收敛/短路模型缺失）不得当作不可行上界。",
        "7. 终止时保留可行下界、不可行上界及间隔。",
        "8. 取各约束容量上界的最小值作为物理约束容量，记录主导限制因素。"
      ],
      "outputs": [
        {"field": "capacity_physical_kw", "unit": "kW",
         "note": "含已并网源基线之上可增加的容量，不再扣一次已并网装机"},
        {"field": "feasible_lower_kw", "unit": "kW"},
        {"field": "infeasible_upper_kw", "unit": "kW"},
        {"field": "bracket_gap_kw", "unit": "kW"},
        {"field": "binding_constraint", "unit": "-"},
        {"field": "search_status", "unit": "enum",
         "note": "ok / at_least_upper_bound / unknown / blocked"}
      ],
      "failure_policy": {
        "retryable": [],
        "needs_data": ["搜索上下界或精度非法"],
        "needs_human": ["需扩展搜索上界", "需改变接入分配策略"],
        "forbidden": ["对上界仍可行宣称已找到最大值",
                      "把 unknown 当作不可行",
                      "把各点独立最大值直接相加"]
      },
      "evidence_policy": ["search_trace.csv", "capacity.csv", "result_hash",
                          "monotonicity.json"],
      "safety_boundary": ["只读分析", "不得使用未批准的管理口径"],
      "test_suite": {
        "golden": ["tests/golden/FD001", "tests/golden/FD002"],
        "negative_cases": ["上界仍可行", "非单调搜索", "unknown 试探点",
                           "基线已违规", "多点独立上限相加"]
      },
      "owner": "Agent/平台研发组",
      "approver": "配网专业复核人",
      "status": "approved",
      "risk_level": "high"
    },
    {
      "skill_id": "HC.ACCESS.CHECK",
      "skill_code": "SK-11",
      "version": "1.0.0",
      "name": "并网申请方案校核",
      "purpose": "对具体并网申请组织基线与增量校核，输出可行性候选、限制因素与整改方向。",
      "business_scope": ["access_check", "remediation_review"],
      "object_levels": ["dt", "feeder"],
      "requires_engine": true,
      "engine": {"id": "opendss", "interface": "OpenDSSDirect.py"},
      "module": "hc_agent.pipeline",
      "entrypoints": ["Pipeline.s04_s05_s06"],
      "inputs": [
        {"field": "application.json", "unit": "kW/kV", "required": true},
        {"field": "task.business_scene", "unit": "-", "required": true,
         "note": "必须为 access_check 或 remediation_review"}
      ],
      "preconditions": [
        "申请材料关键字段完整",
        "前置判定通过：重复申请、接入点存在性、容量单位、设备归属、快照完整性、基线收敛"
      ],
      "procedure": [
        "1. 解析并结构化申请；关键字段缺失则生成补充清单并暂停。",
        "2. 依据规则生成候选接入点与允许的方案变量，不得虚构设备或接线。",
        "3. 使用申请容量（而非容量搜索试探值）执行基线与增量校核。",
        "4. 执行潮流、电压、载流量、三相不平衡与短路容量校核，定位新增申请引起的差异。",
        "5. 区分存量问题与新增变化，不得一概推导为申请导致违规。",
        "6. 基于真实约束结果生成整改方向；建议仅供专业人员复核。",
        "7. 需比较多个接入方案时，各方案分别生成 scenario_set 与 scheme_id。"
      ],
      "outputs": [
        {"field": "decision_candidate", "unit": "enum",
         "note": "可行 / 有条件可行 / 不可行 / 无法评估"},
        {"field": "binding_constraints", "unit": "-"},
        {"field": "baseline_vs_increment", "unit": "-"},
        {"field": "recommended_actions", "unit": "-"},
        {"field": "uncertainties", "unit": "-"},
        {"field": "review_status", "unit": "enum"}
      ],
      "failure_policy": {
        "retryable": [],
        "needs_data": ["申请关键字段缺失"],
        "needs_human": ["多方案取舍", "例外放行"],
        "forbidden": ["自动批准并网", "生成未经计算的可行性结论"]
      },
      "evidence_policy": ["application_ref", "constraint_results.csv",
                          "baseline_vs_increment"],
      "safety_boundary": ["只读分析", "不得作出业务审批决定",
                          "不得自动批准并网、停电或改接线"],
      "test_suite": {
        "golden": ["tests/golden/FD001"],
        "negative_cases": ["字段缺失", "接入点不存在", "重复申请",
                           "存量问题误判为新增"]
      },
      "owner": "配网专业组",
      "approver": "业务主管部门",
      "status": "approved",
      "risk_level": "high"
    },
