      "approver": "配网专业复核人",
      "status": "approved",
      "risk_level": "medium"
    },
    {
      "skill_id": "HC.CONSTRAINT.THERMAL",
      "skill_code": "SK-07",
      "version": "1.0.0",
      "name": "设备载流与反向潮流校核",
      "purpose": "按设备允许能力检查线路、变压器载流率，并按批准边界检查反向潮流。",
      "business_scope": ["capacity_assessment", "capacity_publication", "access_check", "remediation_review"],
      "object_levels": ["dt", "feeder", "substation"],
      "requires_engine": true,
      "engine": {"id": "opendss", "interface": "OpenDSSDirect.py"},
      "module": "hc_agent.model.constraints",
      "entrypoints": ["ConstraintEvaluator.evaluate_thermal",
                      "ConstraintEvaluator.evaluate_reverse_flow"],
      "inputs": [
        {"field": "element_results.csv", "unit": "A/kW", "required": true},
        {"field": "equipment_limits.csv", "unit": "A/kW", "required": true},
        {"field": "rules.yaml:THERMAL_LIMIT", "unit": "pct", "required": true},
        {"field": "rules.yaml:REVERSE_FLOW_LIMIT", "unit": "kW", "required": true}
      ],
      "preconditions": [
        "设备允许载流值 rating_a 齐备",
        "反向潮流判定的端子方向已确认"
      ],
      "procedure": [
        "1. 取元件端子 1 的各相电流与额定值，载流率 = 100×I/I_rated。",
        "2. 只按端子 1 的最大相电流判定，不得跨端子累加（会重复计入）。",
        "3. 缺少设备允许值时标 unknown，不得判为 pass。",
        "4. 反向潮流只对输电类元件（line/transformer/reactor）判定。",
        "5. 端子 1 P>0 表示功率倒送回 bus1，即反向潮流；反向功率 = max(0, P)。",
        "6. 注入型元件（PVSystem/Generator）是反向潮流成因而非承载通道，不参与判定。",
        "7. 余量统一换算至电流或功率口径，不同量纲不得混比。"
      ],
      "outputs": [
        {"field": "current", "unit": "A"}, {"field": "rating", "unit": "A"},
        {"field": "loading", "unit": "pct"}, {"field": "margin", "unit": "pct"},
        {"field": "max_reverse_flow", "unit": "kW"},
        {"field": "status", "unit": "enum"}
      ],
      "failure_policy": {
        "retryable": [],
        "needs_data": ["设备额定载流值缺失"],
        "needs_human": ["反送边界未批准"],
