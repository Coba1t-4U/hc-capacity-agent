      "skill_id": "HC.POWERFLOW.BASELINE",
      "skill_code": "SK-04",
      "version": "1.0.0",
      "name": "基线潮流计算",
      "purpose": "在冻结模型与场景下计算全时间片基线潮流并返回收敛状态与约束结果。",
      "business_scope": ["capacity_assessment", "capacity_publication", "access_check", "remediation_review"],
      "object_levels": ["dt", "feeder", "substation"],
      "requires_engine": true,
      "engine": {"id": "opendss", "interface": "OpenDSSDirect.py",
                 "adapter": "hc_agent.engines.opendss_adapter.OpenDSSAdapter"},
      "module": "hc_agent.model.powerflow",
      "entrypoints": ["run_baseline", "require_baseline_admissible"],
      "inputs": [
        {"field": "Master.dss 及引用文件", "unit": "-", "required": true},
        {"field": "scenarios.json", "unit": "-", "required": true},
        {"field": "task.solver", "unit": "-", "required": true,
         "note": "max_iter、tolerance、timeout_s"}
      ],
      "preconditions": [
        "拓扑校验通过且无阻断缺陷",
        "引擎版本与锁定版本一致",
        "电压基准由 CalcVoltageBases 依元件额定值推导（不得下发 Set voltagebases）"
      ],
      "procedure": [
        "1. 新建独立 OpenDSS 上下文与独立工作目录。",
        "2. Compile 经审核的 Master.dss。",
        "3. 设置该场景的开关、分接与控制。",
        "4. 逐时间片写入负荷 P/Q 与光伏出力参数。",
        "5. Solution.Solve() 并检查 Solution.Converged()。",
        "6. 按母线节点与设备端子提取电压、电流、功率。",
        "7. 执行静默失效检测：Converged 为真但全网电压恒为 0 时必须判为无解。",
        "8. 保存原生模型、参数与输出。"
      ],
      "outputs": [
        {"field": "bus_results.csv", "unit": "V/pu/deg",
         "note": "scenario_id,timestamp,node_id,phase,v_v,v_pu,angle_deg,converged"},
        {"field": "element_results.csv", "unit": "kW/kvar/A/%",
         "note": "明确端子方向；分相量与三相合计分列"},
        {"field": "convergence_status", "unit": "-"},
        {"field": "engine_fingerprint", "unit": "-"}
      ],
      "failure_policy": {
        "retryable": ["引擎临时错误", "依赖加载失败"],
        "needs_data": ["关键参数缺失"],
        "needs_human": ["需改变业务边界或网络状态才能收敛"],
        "forbidden": ["通过关闭必要控制、改变拓扑或放宽业务约束使结果表面收敛",
                      "把不收敛记为可行或不可行"]
      },
      "evidence_policy": ["snapshot_hash", "engine_run_id", "raw_result_uri",
                          "engine_fingerprint", "opendss_adapter.log"],
      "safety_boundary": ["只读分析", "不得下发控制命令", "不得覆盖原始数据",
                          "不得执行用户上传的任意 DSS 脚本"],
      "test_suite": {
        "golden": ["tests/golden/FD001", "tests/golden/FD002",
                   "IEEETestCases/13Bus"],
        "negative_cases": ["不收敛算例", "电压基准错误", "电源未接入"]
      },
      "owner": "计算引擎组",
      "approver": "配网专业复核人",
      "status": "approved",
      "risk_level": "high"
    },
