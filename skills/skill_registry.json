    {
      "skill_id": "HC.CONSTRAINT.VOLTAGE",
      "skill_code": "SK-06",
      "version": "1.0.0",
      "name": "节点电压越限校核",
      "purpose": "按节点、相别、时间片检查电压幅值、持续时间与变化量，输出越限清单与最不利节点。",
      "business_scope": ["capacity_assessment", "capacity_publication", "access_check", "remediation_review"],
      "object_levels": ["dt", "feeder", "substation"],
      "requires_engine": true,
      "engine": {"id": "opendss", "interface": "OpenDSSDirect.py",
                 "note": "指标派生自引擎电压结果，属于结果后处理"},
      "module": "hc_agent.model.constraints",
      "entrypoints": ["ConstraintEvaluator.evaluate_voltage"],
      "inputs": [
        {"field": "bus_results.csv", "unit": "pu", "required": true},
        {"field": "rules.yaml:VOLTAGE_LIMIT", "unit": "pu", "required": true,
         "rule_ref": "VOLTAGE_LIMIT"}
      ],
      "preconditions": [
        "电压 pu 的相电压基准与模型 kVBase 对齐",
        "规则包中 min/max 与 duration_minutes 已批准（非 null）"
      ],
      "procedure": [
        "1. 按 (scenario,node,phase) 收集时间序列。",
        "2. 排除 OpenDSS 内部等值母线（sourcebus），它不是被评估的网络节点。",
        "3. 求最小值与最大值对应的时间片。",
        "4. 按规则 operator 与限值判定，并按相邻时间戳差值累加越限持续时间。",
        "5. 持续时间未达配置阈值时不计为越限。",
        "6. 输出 v_min/v_max、节点、持续时间、余量。"
      ],
      "outputs": [
