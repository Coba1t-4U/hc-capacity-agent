      ],
      "failure_policy": {
        "retryable": [],
        "needs_data": ["电压结果缺失"],
        "needs_human": ["阈值未批准"],
        "forbidden": ["内置未经确认的电压常数", "用经验阈值替代规则"]
      },
      "evidence_policy": ["constraint_id", "limit_source=rule_package", "bus_results.csv"],
