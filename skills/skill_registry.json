    {
      "skill_id": "HC.TOPOLOGY.CONSISTENCY",
      "skill_code": "SK-01",
      "version": "1.0.0",
      "name": "拓扑与模型一致性检查",
      "purpose": "校验网架连通性、孤岛、环路、相别与版本一致性，生成可计算网络的前提结论。",
      "business_scope": ["capacity_assessment", "capacity_publication", "access_check", "remediation_review"],
      "object_levels": ["dt", "feeder", "substation"],
      "voltage_levels_kv": [0.4, 10, 35],
      "requires_engine": false,
      "module": "hc_agent.io.validation",
      "entrypoints": ["check_topology", "check_version_consistency", "check_resource_mapping"],
      "inputs": [
        {"field": "network.xlsx:buses", "unit": "-", "required": true, "note": "节点主键 node_id"},
        {"field": "network.xlsx:lines", "unit": "ohm/km", "required": true},
        {"field": "network.xlsx:transformers", "unit": "kVA/kV/%", "required": false},
        {"field": "network.xlsx:switches", "unit": "A", "required": false},
        {"field": "network.xlsx:sources", "unit": "ohm/pu", "required": true},
        {"field": "network.xlsx:meta.topology_version", "unit": "-", "required": true}
      ],
      "preconditions": [
        "network.xlsx 的 meta 工作表必需键齐备",
        "task.snapshot_id 与 meta.snapshot_id 一致",
        "对象范围 scope.ids 能解析为节点或馈线"
      ],
      "procedure": [
        "1. 校验外键：lines/transformers/loads/pv 的节点引用必须存在于 buses。",
        "2. 校验开关状态与有效时间，断开开关不得构成供电路径。",
        "3. 建图（networkx，不可用时退化为邻接表），求连通分量。",
        "4. 标记无供电路径至 sources 的孤岛节点为阻断缺陷。",
        "5. 从 sources 出发做可达性遍历，校验 scope 与候选接入点可达。",
        "6. 检测多电源边界并记录运行方式确认要求。",
        "7. 校验设备相别不超过节点相别。"
      ],
      "outputs": [
        {"field": "components", "unit": "-", "note": "连通分量列表"},
        {"field": "islands", "unit": "-", "note": "孤岛节点，blocking"},
        {"field": "unreachable", "unit": "-"},
        {"field": "multi_source_boundaries", "unit": "-"},
        {"field": "quality_issues.csv", "unit": "-", "note": "issue_id/file/row/field/severity/code/blocking"}
      ],
      "failure_policy": {
        "retryable": ["临时文件读取失败"],
        "needs_data": ["节点或线路字段缺失"],
        "needs_human": ["拓扑与现场台账不符", "开关状态时标冲突"],
        "forbidden": ["自动补全缺失的网架连接", "猜测相别"]
      },
      "evidence_policy": ["snapshot_hash", "topology_version", "quality_issues.csv"],
      "safety_boundary": ["只读分析", "不得修改源数据", "不得推断不存在的设备或接线"],
      "test_suite": {
        "golden": ["tests/golden/FD001", "tests/golden/FD002"],
        "negative_cases": ["拓扑孤岛", "开关状态矛盾", "重复 node_id", "版本冲突"]
      },
      "owner": "数据治理组",
      "approver": "配网专业复核人",
      "status": "approved",
      "risk_level": "low"
